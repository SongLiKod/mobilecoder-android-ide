<?xml version="1.0" encoding="utf-8"?>
<!--
  允许明文 HTTP：AI 服务常部署在局域网 / 本机（192.168.x.x、10.x、127.0.0.1、Ollama 等），
  而 network-security-config 只支持按域名精确放行、不支持网段(CIDR)，因此整体放开。
  注意：HTTP 为明文传输，走公网的服务请务必填写 https:// 地址，避免 API Key 泄露。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
